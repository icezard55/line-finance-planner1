# Server
PORT=3000

# Postgres connection for the finance_app role (scoped to the `finance` schema only).
# Uses the Supavisor session pooler (IPv4-compatible) — the direct db.<ref>.supabase.co
# host is IPv6-only and will time out from most networks, including Railway.
DATABASE_URL=postgresql://finance_app.mcrhzbrqiwwtudivqpki:REPLACE_WITH_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# LINE Messaging API channel (from LINE Developers Console -> your Messaging API channel)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Login channel ID that your LIFF app belongs to (used to validate the aud claim
# of the ID token LIFF sends us). Found on the same channel's Basic settings page.
LINE_LOGIN_CHANNEL_ID=

# Anthropic API key — used to read payment slip photos sent in LINE chat.
# Leave blank to disable slip-photo reading (bot will ask users to type entries manually).
ANTHROPIC_API_KEY=

# LINE user ID with access to the /api/admin routes (plan upgrades, user list).
ADMIN_LINE_USER_ID=
